{
  "name": "mcp-subscription-sentinel",
  "version": "1.0.0",
  "description": "A pure state machine for detecting stale MCP subscriptions and planning bounded reconnects.",
  "license": "MIT",
  "author": "Huzaifa Asif",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts examples eslint.config.mjs",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:coverage && node examples/reconnect-plan.mjs && npm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huzaifa-Asif/mcp-subscription-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/Huzaifa-Asif/mcp-subscription-sentinel/issues"
  },
  "homepage": "https://github.com/Huzaifa-Asif/mcp-subscription-sentinel#readme"
}
